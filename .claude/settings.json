{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run build)",
      "Bash(npm run test:coverage:*)",
      "Bash(npx jest:*)",
      "Bash(npx tsc:*)"
    ],
    "deny": [
      "Read(./assets/auth/**)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck.js\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
